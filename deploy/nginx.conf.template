# Whitenoise static site. ${FRAME_ANCESTORS} is filled in from the environment
# when the container starts; nginx's own $variables are left untouched.
#
# Caching uses `expires` rather than add_header so the security headers below
# are inherited by every location (add_header in a location would drop them).

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors ${FRAME_ANCESTORS}" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build output never changes under the same name.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location /sounds/ {
        types {
            audio/ogg        ogg opus;
            audio/mp4        m4a mp4;
            audio/mpeg       mp3;
            audio/webm       webm;
            audio/wav        wav;
            application/json json;
        }
        expires 30d;
        try_files $uri =404;
    }

    location = /sounds/manifest.json {
        default_type application/json;
        expires -1;
    }

    # Everything else (index.html, sw.js, web manifest) is revalidated on every
    # load so a new deploy reaches people straight away.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
